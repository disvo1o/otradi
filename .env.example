# ============================================================
# TELEGRAM BOT
# ============================================================

BOT_TOKEN=your_telegram_bot_token
ADMIN_TELEGRAM_ID=your_telegram_id


# ============================================================
# POSTGRESQL
# ============================================================

# Railway автоматически подставит DATABASE_URL
DATABASE_URL=${{Postgres.DATABASE_URL}}


# ============================================================
# GOOGLE SHEETS
# ============================================================

# ID Google Таблицы из URL:
# https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXX/edit

GOOGLE_SHEET_ID=your_google_sheet_id

# В Railway сюда вставляется весь JSON Service Account
# одной переменной.
#
# НЕ добавляй реальный JSON в GitHub.
GOOGLE_SERVICE_ACCOUNT_JSON=your_google_service_account_json


# ============================================================
# SQUAD LINKS
# ============================================================

SQUAD_1_LINK=https://t.me/your_squad_1
SQUAD_2_LINK=https://t.me/your_squad_2
SQUAD_3_LINK=https://t.me/your_squad_3
SQUAD_4_LINK=https://t.me/your_squad_4
SQUAD_5_LINK=https://t.me/your_squad_5
SQUAD_6_LINK=https://t.me/your_squad_6
SQUAD_7_LINK=https://t.me/your_squad_7
SQUAD_8_LINK=https://t.me/your_squad_8
SQUAD_9_LINK=https://t.me/your_squad_9
SQUAD_10_LINK=https://t.me/your_squad_10
